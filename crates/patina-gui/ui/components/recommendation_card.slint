import {
    FilledButton,
    Icon,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    TextButton,
    TonalButton,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { Labels } from "../labels.slint";
import { CardKind } from "../types.slint";
import { TextPromptDialog } from "text_prompt_dialog.slint";

// Icon and label above a card title.
component Overline inherits HorizontalLayout {
    in property <image> icon;
    in property <string> text;

    spacing: MaterialStyleMetrics.spacing_8;

    VerticalLayout {
        alignment: center;

        Icon {
            source: root.icon;
            width: MaterialStyleMetrics.icon_size_18;
            colorize: MaterialPalette.on_primary_container;
        }
    }

    MaterialText {
        text: root.text;
        vertical_alignment: center;
        style: MaterialTypography.label_large;
        color: MaterialPalette.on_primary_container;
    }
}

// The one recommended thing to do next.
export component RecommendationCard inherits Rectangle {
    background: MaterialPalette.primary_container;
    border_radius: MaterialStyleMetrics.border_radius_28;

    layout := VerticalLayout {
        padding: App.wide ? MaterialStyleMetrics.padding_24 : MaterialStyleMetrics.padding_20;
        spacing: MaterialStyleMetrics.spacing_8;

        if App.card.kind == CardKind.item || App.card.kind == CardKind.break_down: VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_4;

            Overline {
                icon: App.card.kind == CardKind.item ? AppIcons.bolt : AppIcons.call_split;
                text: App.card.kind == CardKind.item ? @tr("Next up") : @tr("This one looks big");
            }

            MaterialText {
                text: App.card.item.title;
                wrap: word_wrap;
                overflow: clip;
                style: MaterialTypography.title_large;
                font_weight: MaterialTypography.medium;
                color: MaterialPalette.on_primary_container;
            }

            if App.card.item.path != "": MaterialText {
                text: App.card.item.path;
                style: MaterialTypography.body_medium;
                color: MaterialPalette.on_primary_container;
            }

            for reason in App.card.reasons: HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: MaterialStyleMetrics.size_6;
                        height: MaterialStyleMetrics.size_6;
                        border_radius: MaterialStyleMetrics.size_3;
                        background: MaterialPalette.on_primary_container;
                    }
                }

                MaterialText {
                    text: Labels.reason(reason);
                    style: MaterialTypography.body_medium;
                    color: MaterialPalette.on_primary_container;
                }
            }

            HorizontalLayout {
                alignment: start;
                spacing: MaterialStyleMetrics.spacing_8;
                padding_top: MaterialStyleMetrics.padding_8;

                if App.card.kind == CardKind.item: FilledButton {
                    icon: AppIcons.play_arrow;
                    text: @tr("Start");

                    clicked => {
                        App.card_start();
                    }
                }

                if App.card.kind == CardKind.break_down: FilledButton {
                    icon: AppIcons.call_split;
                    text: @tr("Split");

                    clicked => {
                        split.open("");
                    }
                }

                TonalButton {
                    icon: AppIcons.skip_next;
                    text: @tr("Skip");

                    clicked => {
                        App.card_skip();
                    }
                }

                if App.card.kind == CardKind.item: TextButton {
                    text: @tr("Too big");

                    clicked => {
                        split.open("");
                    }
                }
            }
        }

        if App.card.kind == CardKind.review: VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_8;

            Overline {
                icon: AppIcons.rate_review;
                text: @tr("Weekly review");
            }

            MaterialText {
                text: App.card.since != "" ? @tr("The weekly review is due (last: {})", App.card.since) : @tr("The weekly review is due");
                wrap: word_wrap;
                overflow: clip;
                style: MaterialTypography.title_large;
                color: MaterialPalette.on_primary_container;
            }

            HorizontalLayout {
                alignment: start;
                spacing: MaterialStyleMetrics.spacing_8;
                padding_top: MaterialStyleMetrics.padding_8;

                FilledButton {
                    text: @tr("Start review");

                    clicked => {
                        App.navigate(4);
                    }
                }

                TonalButton {
                    icon: AppIcons.skip_next;
                    text: @tr("Skip");

                    clicked => {
                        App.card_skip();
                    }
                }
            }
        }

        if App.card.kind == CardKind.triage: VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_8;

            Overline {
                icon: AppIcons.inbox;
                text: @tr("Inbox");
            }

            MaterialText {
                text: @tr("{} thoughts are waiting in the inbox", App.card.inbox);
                wrap: word_wrap;
                overflow: clip;
                style: MaterialTypography.title_large;
                color: MaterialPalette.on_primary_container;
            }

            HorizontalLayout {
                alignment: start;
                spacing: MaterialStyleMetrics.spacing_8;
                padding_top: MaterialStyleMetrics.padding_8;

                FilledButton {
                    text: @tr("Triage");

                    clicked => {
                        App.navigate(1);
                    }
                }

                TonalButton {
                    icon: AppIcons.skip_next;
                    text: @tr("Skip");

                    clicked => {
                        App.card_skip();
                    }
                }
            }
        }

        if App.card.kind == CardKind.empty: VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_4;

            Overline {
                icon: AppIcons.task_alt;
                text: @tr("All clear");
            }

            MaterialText {
                text: @tr("Nothing to do here");
                style: MaterialTypography.title_large;
                color: MaterialPalette.on_primary_container;
            }

            for row in App.card.elsewhere: MaterialText {
                text: @tr("{}: {} actionable", row.label, row.count);
                style: MaterialTypography.body_medium;
                color: MaterialPalette.on_primary_container;
            }
        }
    }

    split := TextPromptDialog {
        title: @tr("Too big");
        icon: AppIcons.call_split;
        label: @tr("What could you do in the first 5 minutes?");
        action_text: @tr("Split");

        submitted(text) => {
            return App.card_split(text);
        }
    }
}
