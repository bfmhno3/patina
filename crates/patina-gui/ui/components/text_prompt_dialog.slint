import { TextField } from "@material";
import { App } from "../app.slint";
import { PromptDialog } from "prompt_dialog.slint";

// One text field. `submitted` returns "" to close or an error to show.
export component TextPromptDialog inherits Rectangle {
    in property <string> title;
    in property <string> label;
    in property <string> hint;
    in property <image> icon;
    in property <string> action_text: @tr("OK");
    property <string> error;
    property <string> value;

    callback submitted(text: string) -> string;

    width: 0;
    height: 0;

    public function open(initial: string) {
        root.value = initial;
        root.error = "";
        dlg.show();
    }

    function submit() {
        root.error = root.submitted(root.value);
        if root.error == "" {
            dlg.close();
        }
    }

    dlg := PromptDialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: App.window_width;
        height: App.window_height;
        title: root.title;
        icon: root.icon;
        error: root.error;
        action_text: root.action_text;

        accepted => {
            root.submit();
        }

        TextField {
            text <=> root.value;
            label: root.label;
            supporting_text: root.hint;

            accepted(text) => {
                root.submit();
            }
        }
    }
}
