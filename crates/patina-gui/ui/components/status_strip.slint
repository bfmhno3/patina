import {
    Icon,
    IconButton,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    TextButton,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { Labels } from "../labels.slint";
import { InterruptDialog } from "interrupt_dialog.slint";
import { StuckDialog } from "stuck_dialog.slint";

// What is running or paused right now, plus urgent items of other identities.
export component StatusStrip inherits Rectangle {
    property <bool> any: App.timer.running || App.rhythm.on_break || App.today.banner_items.length > 0 || App.today.banner_habits.length > 0;

    layout := VerticalLayout {
        spacing: MaterialStyleMetrics.spacing_8;
        padding_bottom: root.any ? MaterialStyleMetrics.padding_8 : 0px;

        if App.timer.running: Rectangle {
            border_radius: MaterialStyleMetrics.border_radius_16;
            background: MaterialPalette.tertiary_container;

            HorizontalLayout {
                padding_left: MaterialStyleMetrics.padding_16;
                padding_right: MaterialStyleMetrics.padding_4;
                padding_top: MaterialStyleMetrics.padding_4;
                padding_bottom: MaterialStyleMetrics.padding_4;
                spacing: MaterialStyleMetrics.spacing_12;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        source: AppIcons.timer;
                        width: MaterialStyleMetrics.icon_size_24;
                        colorize: MaterialPalette.on_tertiary_container;
                    }
                }

                VerticalLayout {
                    horizontal_stretch: 1;
                    alignment: center;

                    MaterialText {
                        text: @tr("Timing");
                        color: MaterialPalette.on_tertiary_container;
                        style: MaterialTypography.label_medium;
                    }

                    MaterialText {
                        text: App.timer.label;
                        overflow: elide;
                        color: MaterialPalette.on_tertiary_container;
                        style: MaterialTypography.title_medium;
                    }
                }

                MaterialText {
                    text: Labels.minutes(App.timer.minutes);
                    vertical_alignment: center;
                    color: MaterialPalette.on_tertiary_container;
                    style: MaterialTypography.title_medium;
                }

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: AppIcons.stop;
                        tooltip: @tr("Stop");

                        clicked => {
                            App.stop_timer();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: AppIcons.hourglass_empty;
                        tooltip: @tr("Stuck");
                        enabled: !App.timer.is_habit;

                        clicked => {
                            stuck.open("");
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: AppIcons.bolt;
                        tooltip: @tr("Interrupt");

                        clicked => {
                            interrupt.open();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: AppIcons.coffee;
                        tooltip: @tr("Break");

                        clicked => {
                            App.start_break();
                        }
                    }
                }
            }
        }

        if App.rhythm.on_break: Rectangle {
            border_radius: MaterialStyleMetrics.border_radius_16;
            background: MaterialPalette.secondary_container;

            HorizontalLayout {
                padding: MaterialStyleMetrics.padding_16;
                spacing: MaterialStyleMetrics.spacing_12;

                VerticalLayout {
                    alignment: center;

                    Icon {
                        source: AppIcons.coffee;
                        width: MaterialStyleMetrics.icon_size_24;
                        colorize: MaterialPalette.on_secondary_container;
                    }
                }

                MaterialText {
                    text: @tr("On a {} break until {}", Labels.break_kind(App.rhythm.break_kind), App.rhythm.break_ends);
                    horizontal_stretch: 1;
                    vertical_alignment: center;
                    color: MaterialPalette.on_secondary_container;
                    style: MaterialTypography.title_small;
                }

                if App.rhythm.resume_label != "": TextButton {
                    text: @tr("Resume {}", App.rhythm.resume_label);

                    clicked => {
                        App.resume();
                    }
                }
            }
        }

        if App.today.banner_items.length + App.today.banner_habits.length > 0: Rectangle {
            border_radius: MaterialStyleMetrics.border_radius_16;
            background: MaterialPalette.surface_container_high;

            VerticalLayout {
                padding: MaterialStyleMetrics.padding_12;
                spacing: MaterialStyleMetrics.spacing_4;

                for item in App.today.banner_items: HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_8;

                    VerticalLayout {
                        alignment: center;

                        Icon {
                            source: AppIcons.warning;
                            width: MaterialStyleMetrics.icon_size_18;
                            colorize: MaterialPalette.error;
                        }
                    }

                    MaterialText {
                        text: item.identity + ": " + item.title + (item.deadline != "" ? " · " + @tr("due {}", item.deadline) : "") + (item.follow_up != "" ? " · " + @tr("follow up {}", item.follow_up) : "");
                        overflow: elide;
                        style: MaterialTypography.body_medium;
                    }
                }

                for habit in App.today.banner_habits: HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_8;

                    VerticalLayout {
                        alignment: center;

                        Icon {
                            source: AppIcons.event_repeat;
                            width: MaterialStyleMetrics.icon_size_18;
                            colorize: MaterialPalette.primary;
                        }
                    }

                    MaterialText {
                        text: habit.identity + ": " + habit.name;
                        overflow: elide;
                        style: MaterialTypography.body_medium;
                    }
                }
            }
        }
    }

    stuck := StuckDialog { }

    interrupt := InterruptDialog { }
}
