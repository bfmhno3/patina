import {
    Icon,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    StateLayerArea,
} from "@material";

// A list row: optional leading icon, title, one supporting line, trailing children. Material's
// own list tile sizes itself from its content, which loops inside scroll views, so the height is fixed.
export component Tile inherits Rectangle {
    in property <string> text;
    in property <string> supporting_text;
    in property <image> leading_icon;
    in property <bool> divider;

    callback clicked();

    min_height: MaterialStyleMetrics.size_64;

    StateLayerArea {
        color: MaterialPalette.on_surface;

        clicked => {
            root.clicked();
        }

        HorizontalLayout {
            padding_left: root.leading_icon.width > 0 ? MaterialStyleMetrics.padding_8 : MaterialStyleMetrics.padding_16;
            padding_right: MaterialStyleMetrics.padding_8;
            padding_top: MaterialStyleMetrics.padding_8;
            padding_bottom: MaterialStyleMetrics.padding_8;
            spacing: MaterialStyleMetrics.spacing_8;

            if root.leading_icon.width > 0: Rectangle {
                width: MaterialStyleMetrics.size_48;

                Icon {
                    source: root.leading_icon;
                    width: MaterialStyleMetrics.icon_size_24;
                    colorize: MaterialPalette.on_surface_variant;
                }
            }

            text_column := VerticalLayout {
                alignment: center;
                horizontal_stretch: 1;

                MaterialText {
                    text: root.text;
                    overflow: elide;
                    style: MaterialTypography.body_large;
                }

                if root.supporting_text != "": MaterialText {
                    text: root.supporting_text;
                    overflow: elide;
                    color: MaterialPalette.on_surface_variant;
                    style: MaterialTypography.body_medium;
                }
            }

            @children
        }
    }

    if root.divider: Rectangle {
        x: text_column.x;
        y: 0;
        width: root.width - self.x;
        height: MaterialStyleMetrics.size_1;
        background: MaterialPalette.outline_variant;
    }
}
