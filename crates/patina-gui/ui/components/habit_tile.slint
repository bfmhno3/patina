import {
    CircularProgressIndicator,
    Icon,
    IconButton,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    PopupMenu,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { Labels } from "../labels.slint";
import { DayPills } from "day_pills.slint";
import { FrequencyUi, HabitKindUi, HabitRow } from "../types.slint";

// One habit: progress ring with the primary action by kind, strength, overflow menu.
export component HabitTile inherits Rectangle {
    in property <HabitRow> data;

    callback check_in_requested();
    callback skip_requested();
    callback edit_requested();

    in property <bool> divider;
    // Also show the frequency and weekdays.
    in property <bool> detailed;

    min_height: MaterialStyleMetrics.size_72;

    property <bool> off: root.data.paused || root.data.stage == "graduated";

    function progress() -> string {
        if root.data.kind == HabitKindUi.count {
            return @tr("{} / {}", root.data.count, root.data.target);
        }
        if root.data.kind == HabitKindUi.duration {
            return @tr("{} / {} min", root.data.minutes, root.data.target);
        }
        if root.data.week_target > 0 {
            return @tr("{} / {} this week", Math.round(root.data.week_value), root.data.week_target);
        }
        return root.data.value >= 1 ? @tr("done") : @tr("to do");
    }

    HorizontalLayout {
        padding_left: MaterialStyleMetrics.padding_8;
        padding_right: MaterialStyleMetrics.padding_8;
        padding_top: MaterialStyleMetrics.padding_8;
        padding_bottom: MaterialStyleMetrics.padding_8;
        spacing: MaterialStyleMetrics.spacing_8;

        // Leading slot: progress ring with the primary action on top.
        Rectangle {
            width: MaterialStyleMetrics.size_48;

            CircularProgressIndicator {
                height: MaterialStyleMetrics.size_40;
                progress: root.data.week_target > 0 && root.data.kind == HabitKindUi.check ? min(root.data.week_value / root.data.week_target, 1) : min(root.data.value, 1);
            }

            if root.data.paused: Icon {
                source: AppIcons.pause;
                width: MaterialStyleMetrics.icon_size_18;
                colorize: MaterialPalette.on_surface_variant;
            }

            if !root.data.paused && root.data.stage == "graduated": Icon {
                source: AppIcons.star;
                width: MaterialStyleMetrics.icon_size_18;
                colorize: MaterialPalette.tertiary;
            }

            if !root.data.paused && root.data.stage != "graduated" && root.data.kind == HabitKindUi.check: Icon {
                source: AppIcons.check;
                width: MaterialStyleMetrics.icon_size_18;
                colorize: root.data.value >= 1 ? MaterialPalette.primary : MaterialPalette.on_surface_variant;
            }

            if !root.data.paused && root.data.stage != "graduated" && root.data.kind == HabitKindUi.count: Icon {
                source: AppIcons.add;
                width: MaterialStyleMetrics.icon_size_18;
                colorize: MaterialPalette.on_surface_variant;
            }

            if !root.data.paused && root.data.stage != "graduated" && root.data.kind == HabitKindUi.duration: Icon {
                source: AppIcons.play_arrow;
                width: MaterialStyleMetrics.icon_size_18;
                colorize: MaterialPalette.on_surface_variant;
            }

            TouchArea {
                enabled: !root.off && !(root.data.kind == HabitKindUi.check && root.data.value >= 1);

                clicked => {
                    if root.data.kind == HabitKindUi.check {
                        App.check_in(root.data.id, 0, -1, "");
                    } else if root.data.kind == HabitKindUi.count {
                        root.check_in_requested();
                    } else {
                        App.start_habit_timer(root.data.id);
                    }
                }
            }
        }

        text_column := VerticalLayout {
            horizontal_stretch: 1;
            alignment: center;
            spacing: MaterialStyleMetrics.spacing_2;

            MaterialText {
                text: root.data.name;
                overflow: elide;
                style: MaterialTypography.body_large;
            }

            MaterialText {
                text: root.progress() + " · " + root.data.identity + (root.detailed ? " · " + (root.data.frequency == FrequencyUi.daily ? @tr("Every day") : root.data.frequency == FrequencyUi.weekly ? @tr("{} times a week", root.data.times) : @tr("On specific weekdays")) : "") + (root.data.ready ? " · " + @tr("ready to graduate") : "");
                overflow: elide;
                color: MaterialPalette.on_surface_variant;
                style: MaterialTypography.body_medium;
            }

            if root.detailed && root.data.days.length > 0: DayPills {
                days: root.data.days;
            }
        }

        VerticalLayout {
            alignment: center;

            MaterialText {
                text: @tr("{}%", Math.round(root.data.strength * 100));
                horizontal_alignment: right;
                color: MaterialPalette.primary;
                style: MaterialTypography.title_small;
            }

            MaterialText {
                text: Labels.habit_stage(root.data.stage);
                horizontal_alignment: right;
                color: MaterialPalette.on_surface_variant;
                style: MaterialTypography.label_small;
            }
        }

        VerticalLayout {
            alignment: center;

            IconButton {
                icon: AppIcons.more_vert;
                tooltip: @tr("More");

                clicked => {
                    menu.show();
                }
            }
        }
    }

    if root.divider: Rectangle {
        x: text_column.x;
        y: 0;
        width: root.width - self.x;
        height: MaterialStyleMetrics.size_1;
        background: MaterialPalette.outline_variant;
    }

    menu := PopupMenu {
        x: root.width - self.width;
        y: root.height / 2;
        items: [
            { text: @tr("Check in…"), enabled: !root.off },
            { text: @tr("Skip…"), enabled: !root.off },
            {
                text: root.data.paused ? @tr("Resume") : @tr("Pause"),
                enabled: root.data.stage != "graduated"
            },
            { text: @tr("Edit…"), enabled: true },
            {
                text: root.data.stage == "graduated" ? @tr("Reinstate") : @tr("Graduate"),
                enabled: !root.data.paused
            },
        ];

        activated(index) => {
            menu.close();
            if index == 0 {
                root.check_in_requested();
            } else if index == 1 {
                root.skip_requested();
            } else if index == 2 {
                if root.data.paused {
                    App.resume_habit(root.data.id);
                } else {
                    App.pause_habit(root.data.id);
                }
            } else if index == 3 {
                root.edit_requested();
            } else if root.data.stage == "graduated" {
                App.reinstate_habit(root.data.id);
            } else {
                App.graduate_habit(root.data.id);
            }
        }
    }
}
