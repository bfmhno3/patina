import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    TextField,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { PromptKind } from "../types.slint";
import { PromptDialog } from "prompt_dialog.slint";

// Idle prompts: "when did you stop?" for a forgotten timer or identity mode.
export component TimeCorrectionDialog inherits Rectangle {
    property <string> error;
    property <string> time_value;
    property <bool> for_timer;

    width: 0;
    height: 0;

    public function open() {
        root.for_timer = App.prompt.kind == PromptKind.timer_idle;
        root.time_value = App.prompt.default_time;
        root.error = "";
        dlg.show();
    }

    dlg := PromptDialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: App.window_width;
        height: App.window_height;
        title: root.for_timer ? @tr("Timer still running") : @tr("Still here?");
        icon: root.for_timer ? AppIcons.timer : AppIcons.schedule;
        error: root.error;
        cancel_text: root.for_timer ? @tr("Still working") : @tr("Still here");
        action_text: root.for_timer ? @tr("Stop at") : @tr("Away from");

        accepted => {
            if root.for_timer {
                root.error = App.correct_timer(root.time_value);
            } else {
                root.error = App.correct_mode(root.time_value);
            }
            if root.error == "" {
                dlg.close();
            }
        }
        cancelled => {
            if root.for_timer {
                App.keep_timer();
            } else {
                App.keep_mode();
            }
        }

        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_12;

            MaterialText {
                text: root.for_timer ? @tr("The timer on {} has run since {}. When did you stop?", App.prompt.label, App.prompt.since) : @tr("{} mode since {}. When did you leave?", App.prompt.label, App.prompt.since);
                wrap: word_wrap;
                overflow: clip;
                style: MaterialTypography.body_medium;
                color: MaterialPalette.on_surface_variant;
            }

            TextField {
                text <=> root.time_value;
                label: @tr("Time (HH:MM)");
                leading_icon: AppIcons.schedule;
            }
        }
    }
}
