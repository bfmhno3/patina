import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    Switch,
    TextField,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { ChoiceRow } from "choice_row.slint";
import { PromptDialog } from "prompt_dialog.slint";

// Park an interruption in the inbox, or hand the timer over to it.
export component InterruptDialog inherits Rectangle {
    property <string> error;
    property <bool> now;
    property <string> identity_value;
    property <string> text_value;
    property <string> left_off_value;

    width: 0;
    height: 0;

    public function open() {
        root.error = "";
        root.now = false;
        root.text_value = "";
        root.left_off_value = "";
        root.identity_value = App.identities[0];
        dlg.show();
    }

    dlg := PromptDialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: App.window_width;
        height: App.window_height;
        title: @tr("Interruption");
        icon: AppIcons.bolt;
        error: root.error;
        action_text: @tr("Save");

        accepted => {
            root.error = App.interrupt(root.text_value, root.now, root.now ? root.identity_value : "", root.now ? root.left_off_value : "");
            if root.error == "" {
                dlg.close();
            }
        }

        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_12;

            TextField {
                text <=> root.text_value;
                label: @tr("What came up?");
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_16;

                VerticalLayout {
                    horizontal_stretch: 1;
                    alignment: center;

                    MaterialText {
                        text: @tr("Handle it now");
                        style: MaterialTypography.body_large;
                    }

                    MaterialText {
                        text: root.now ? @tr("Creates a chore and switches the timer to it") : @tr("Goes to the inbox; the timer keeps running");
                        wrap: word_wrap;
                        overflow: clip;
                        style: MaterialTypography.body_medium;
                        color: MaterialPalette.on_surface_variant;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Switch {
                        checked <=> root.now;
                    }
                }
            }

            if root.now: MaterialText {
                text: @tr("Identity");
                style: MaterialTypography.label_large;
                color: MaterialPalette.on_surface_variant;
            }

            if root.now: ChoiceRow {
                options: App.identities;
                by_value: true;
                value <=> root.identity_value;
            }

            if root.now: TextField {
                text <=> root.left_off_value;
                label: @tr("Where did you leave off?");
                leading_icon: AppIcons.edit_note;
            }
        }
    }
}
