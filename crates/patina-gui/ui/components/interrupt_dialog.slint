import {
    Dialog,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    Switch,
    TextField,
} from "@material";
import { App } from "../app.slint";
import { ChoiceRow } from "choice_row.slint";

// Park an interruption in the inbox, or hand the timer over to it.
export component InterruptDialog inherits Rectangle {
    property <string> error;
    property <bool> now;
    property <string> identity_value;
    property <string> text_value;
    property <string> left_off_value;

    width: 0;
    height: 0;

    public function open() {
        root.error = "";
        root.now = false;
        root.text_value = "";
        root.left_off_value = "";
        root.identity_value = App.identities[0];
        dlg.show();
    }

    dlg := Dialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: App.window_width;
        height: App.window_height;
        title: @tr("Interruption");
        actions: [@tr("Cancel")];
        default_action_text: @tr("Save");

        default_action_clicked => {
            root.error = App.interrupt(root.text_value, root.now, root.now ? root.identity_value : "", root.now ? root.left_off_value : "");
            if root.error == "" {
                dlg.close();
            }
        }
        action_clicked(index) => {
            dlg.close();
        }

        VerticalLayout {
            min_width: min(MaterialStyleMetrics.size_344, App.window_width - MaterialStyleMetrics.size_48);
            spacing: MaterialStyleMetrics.spacing_8;

            TextField {
                text <=> root.text_value;
                label: @tr("What came up?");
                has_error: root.error != "";
                supporting_text: root.error;
            }

            HorizontalLayout {
                alignment: start;
                spacing: MaterialStyleMetrics.spacing_16;

                MaterialText {
                    text: @tr("Handle it now");
                    vertical_alignment: center;
                    style: MaterialTypography.body_large;
                }

                Switch {
                    checked <=> root.now;
                }
            }

            if root.now: ChoiceRow {
                options: App.identities;
                by_value: true;
                value <=> root.identity_value;
            }

            if root.now: TextField {
                text <=> root.left_off_value;
                label: @tr("Where did you leave off?");
            }
        }
    }
}
