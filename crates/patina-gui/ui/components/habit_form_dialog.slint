import {
    FilterChip,
    FullscreenDialog,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    ScrollView,
    TextField,
} from "@material";
import { App } from "../app.slint";
import { Labels } from "../labels.slint";
import { HabitForm } from "../types.slint";
import { ChoiceRow } from "choice_row.slint";

// Create a habit (mode 0) or edit its name, identity, and cue (mode 1).
export component HabitFormDialog inherits Rectangle {
    property <int> mode;
    property <string> target_id;
    property <string> error;
    property <string> name_value;
    property <string> identity_value;
    property <string> cue_value;
    property <string> target_value;
    property <string> times_value;
    property <int> kind_value;
    property <int> frequency_value;
    property <bool> d0;
    property <bool> d1;
    property <bool> d2;
    property <bool> d3;
    property <bool> d4;
    property <bool> d5;
    property <bool> d6;

    width: 0;
    height: 0;

    public function open(mode: int, id: string, name: string, identity: string, cue: string) {
        root.mode = mode;
        root.target_id = id;
        root.error = "";
        root.name_value = name;
        root.identity_value = identity != "" ? identity : App.identities[0];
        root.cue_value = cue;
        root.target_value = "1";
        root.times_value = "3";
        root.kind_value = 0;
        root.frequency_value = 0;
        root.d0 = true;
        root.d1 = true;
        root.d2 = true;
        root.d3 = true;
        root.d4 = true;
        root.d5 = false;
        root.d6 = false;
        dlg.show();
    }

    function submit() {
        if root.mode == 1 {
            root.error = App.edit_habit(root.target_id, root.name_value, root.identity_value, root.cue_value);
        } else {
            root.error = App.add_habit({
                name: root.name_value,
                identity: root.identity_value,
                cue: root.cue_value,
                kind: root.kind_value,
                target: Math.round(root.target_value.to_float()),
                frequency: root.frequency_value,
                times: Math.round(root.times_value.to_float()),
                days: [root.d0, root.d1, root.d2, root.d3, root.d4, root.d5, root.d6],
            });
        }
        if root.error == "" {
            dlg.close();
        }
    }

    dlg := FullscreenDialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: App.window_width;
        height: App.window_height;
        title: root.mode == 0 ? @tr("New habit") : @tr("Edit habit");
        actions: [@tr("Save")];

        action_clicked(index) => {
            root.submit();
        }

        ScrollView {
            VerticalLayout {
                padding: MaterialStyleMetrics.padding_16;
                padding_top: 0;
                spacing: MaterialStyleMetrics.spacing_8;

                if root.error != "": MaterialText {
                    text: root.error;
                    wrap: word_wrap;
                    overflow: clip;
                    color: MaterialPalette.error;
                }

                TextField {
                    text <=> root.name_value;
                    label: @tr("Name");
                }

                ChoiceRow {
                    options: App.identities;
                    by_value: true;
                    value <=> root.identity_value;
                }

                TextField {
                    text <=> root.cue_value;
                    label: @tr("Cue");
                    supporting_text: @tr("When or where you will do it");
                }

                if root.mode == 0: MaterialText {
                    text: @tr("Kind");
                    style: MaterialTypography.label_large;
                }

                if root.mode == 0: ChoiceRow {
                    options: [@tr("Check"), @tr("Count"), @tr("Duration")];
                    current <=> root.kind_value;
                }

                if root.mode == 0 && root.kind_value != 0: TextField {
                    text <=> root.target_value;
                    label: root.kind_value == 1 ? @tr("Daily count") : @tr("Daily minutes");
                    input_type: number;
                }

                if root.mode == 0: MaterialText {
                    text: @tr("How often");
                    style: MaterialTypography.label_large;
                }

                if root.mode == 0: ChoiceRow {
                    options: [@tr("Daily"), @tr("Per week"), @tr("Weekdays")];
                    current <=> root.frequency_value;
                }

                if root.mode == 0 && root.frequency_value == 1: TextField {
                    text <=> root.times_value;
                    label: @tr("Times per week");
                    input_type: number;
                }

                Rectangle {
                    visible: root.mode == 0 && root.frequency_value == 2;
                    min_height: root.mode == 0 && root.frequency_value == 2 ? MaterialStyleMetrics.size_48 : 0;
                    max_height: self.min_height;

                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_4;

                        FilterChip {
                            checked <=> root.d0;
                            text: Labels.weekday("mon");
                        }

                        FilterChip {
                            checked <=> root.d1;
                            text: Labels.weekday("tue");
                        }

                        FilterChip {
                            checked <=> root.d2;
                            text: Labels.weekday("wed");
                        }

                        FilterChip {
                            checked <=> root.d3;
                            text: Labels.weekday("thu");
                        }

                        FilterChip {
                            checked <=> root.d4;
                            text: Labels.weekday("fri");
                        }

                        FilterChip {
                            checked <=> root.d5;
                            text: Labels.weekday("sat");
                        }

                        FilterChip {
                            checked <=> root.d6;
                            text: Labels.weekday("sun");
                        }
                    }
                }
            }
        }
    }
}
