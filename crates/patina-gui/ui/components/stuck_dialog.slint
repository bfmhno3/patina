import { MaterialStyleMetrics, TextField } from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { DateField } from "date_field.slint";
import { DatePickerDialog } from "date_picker_dialog.slint";
import { PromptDialog } from "prompt_dialog.slint";

// Block an item (or the running timer's item) on something external.
export component StuckDialog inherits Rectangle {
    property <string> item_id;
    property <string> error;
    property <string> waiting_value;
    property <string> follow_up_value;

    width: 0;
    height: 0;

    // An empty id means the item that is being timed.
    public function open(id: string) {
        root.item_id = id;
        root.error = "";
        root.waiting_value = "";
        root.follow_up_value = "";
        dlg.show();
    }

    dlg := PromptDialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: App.window_width;
        height: App.window_height;
        title: @tr("Stuck on something external");
        icon: AppIcons.hourglass_empty;
        error: root.error;
        action_text: @tr("Save");

        accepted => {
            root.error = App.stuck(root.item_id, root.waiting_value, root.follow_up_value);
            if root.error == "" {
                dlg.close();
            }
        }

        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_12;

            TextField {
                text <=> root.waiting_value;
                label: @tr("Waiting for");
                leading_icon: AppIcons.person;
            }

            DateField {
                label: @tr("Follow up on");
                value <=> root.follow_up_value;

                pick => {
                    calendar.open(root.follow_up_value);
                }
            }
        }
    }

    calendar := DatePickerDialog {
        title: @tr("Follow up on");

        picked(value) => {
            root.follow_up_value = value;
        }
    }
}
