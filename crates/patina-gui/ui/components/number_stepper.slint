import {
    IconButton,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
} from "@material";
import { AppIcons } from "../icons.slint";

// A labelled integer with − and + buttons; the value stays within [minimum, maximum].
export component NumberStepper inherits HorizontalLayout {
    in property <string> label;
    in property <string> suffix;
    in property <int> minimum: 0;
    in property <int> maximum: 999;
    in property <int> step: 1;
    in_out property <int> value;

    min_height: MaterialStyleMetrics.size_48;
    spacing: MaterialStyleMetrics.spacing_8;

    MaterialText {
        text: root.label;
        horizontal_stretch: 1;
        vertical_alignment: center;
        wrap: word_wrap;
        style: MaterialTypography.body_large;
    }

    VerticalLayout {
        alignment: center;

        IconButton {
            icon: AppIcons.remove;
            tooltip: @tr("Less");
            enabled: root.value > root.minimum;

            clicked => {
                root.value = max(root.minimum, root.value - root.step);
            }
        }
    }

    MaterialText {
        text: "\{root.value}";
        min_width: MaterialStyleMetrics.size_40;
        horizontal_alignment: center;
        vertical_alignment: center;
        style: MaterialTypography.title_medium;
    }

    if root.suffix != "": MaterialText {
        text: root.suffix;
        vertical_alignment: center;
        style: MaterialTypography.body_medium;
        color: MaterialPalette.on_surface_variant;
    }

    VerticalLayout {
        alignment: center;

        IconButton {
            icon: AppIcons.add;
            tooltip: @tr("More");
            enabled: root.value < root.maximum;

            clicked => {
                root.value = min(root.maximum, root.value + root.step);
            }
        }
    }
}
