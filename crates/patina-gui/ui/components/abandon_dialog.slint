import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    TextField,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { Labels } from "../labels.slint";
import { OptionRow } from "option_row.slint";
import { PromptDialog } from "prompt_dialog.slint";

export component AbandonDialog inherits Rectangle {
    property <string> item_id;
    property <int> reason;
    property <string> error;
    property <string> note_value;

    width: 0;
    height: 0;

    public function open(id: string) {
        root.item_id = id;
        root.reason = 0;
        root.error = "";
        root.note_value = "";
        dlg.show();
    }

    pure function reason_icon(i: int) -> image {
        if i == 0 {
            return AppIcons.visibility_off;
        } else if i == 1 {
            return AppIcons.swap_horiz;
        } else if i == 2 {
            return AppIcons.block;
        }
        return AppIcons.edit_note;
    }

    dlg := PromptDialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: App.window_width;
        height: App.window_height;
        title: @tr("Abandon");
        icon: AppIcons.do_not_disturb_on;
        error: root.error;
        action_text: @tr("Abandon");

        accepted => {
            root.error = App.abandon(root.item_id, root.reason, root.note_value);
            if root.error == "" {
                dlg.close();
            }
        }

        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_4;

            MaterialText {
                text: @tr("Why are you letting this go?");
                wrap: word_wrap;
                overflow: clip;
                style: MaterialTypography.body_medium;
                color: MaterialPalette.on_surface_variant;
            }

            for i in [0, 1, 2, 3]: OptionRow {
                text: Labels.abandon_reason(i);
                icon: root.reason_icon(i);
                selected: root.reason == i;

                clicked => {
                    root.reason = i;
                }
            }

            Rectangle {
                height: MaterialStyleMetrics.spacing_8;
            }

            TextField {
                text <=> root.note_value;
                label: @tr("Note");
            }
        }
    }
}
