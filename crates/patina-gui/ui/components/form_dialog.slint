import {
    Elevation,
    FilledButton,
    IconButton,
    MaterialAnimations,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    ScrollView,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";

// A form shell: a centered card on wide windows, full screen on narrow ones. Never closes on an outside tap, so a mis-tap cannot drop edits; the close button and Escape do. An empty `action_text` hides the button (pickers).
export component FormDialog inherits PopupWindow {
    in property <string> title;
    in property <string> action_text;

    callback accepted();

    property <bool> floating: App.wide;
    property <length> safe_width: root.width - App.inset_left - App.inset_right;
    property <length> safe_height: root.height - App.inset_top - App.inset_bottom;

    close_policy: no_auto_close;
    forward_focus: focus_scope;

    focus_scope := FocusScope {
        x: 0;
        width: 0;

        key_pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.floating ? MaterialPalette.background_modal : transparent;

        TouchArea { }
    }

    panel := Elevation {
        x: root.floating ? App.inset_left + (root.safe_width - self.width) / 2 : 0;
        y: root.floating ? App.inset_top + (root.safe_height - self.height) / 2 : 0;
        width: root.floating ? min(MaterialStyleMetrics.size_640, root.safe_width - 2 * MaterialStyleMetrics.padding_24) : root.width;
        height: root.floating ? root.safe_height - 2 * MaterialStyleMetrics.padding_24 : root.height;
        level: root.floating ? 3 : 0;
        border_radius: root.floating ? MaterialStyleMetrics.border_radius_28 : 0px;
        background: MaterialPalette.surface;
        opacity: 0;

        animate opacity {
            duration: MaterialAnimations.opacity_duration;
            easing: MaterialAnimations.opacity_easing;
        }

        VerticalLayout {
            padding_top: root.floating ? 0px : App.inset_top;
            padding_bottom: root.floating ? 0px : App.inset_bottom;
            padding_left: root.floating ? 0px : App.inset_left;
            padding_right: root.floating ? 0px : App.inset_right;

            HorizontalLayout {
                min_height: MaterialStyleMetrics.size_64;
                padding_left: MaterialStyleMetrics.padding_8;
                padding_right: MaterialStyleMetrics.padding_16;
                spacing: MaterialStyleMetrics.spacing_8;

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: AppIcons.close;
                        tooltip: @tr("Close");

                        clicked => {
                            root.close();
                        }
                    }
                }

                MaterialText {
                    text: root.title;
                    horizontal_stretch: 1;
                    vertical_alignment: center;
                    overflow: elide;
                    style: MaterialTypography.title_large;
                }

                if root.action_text != "": VerticalLayout {
                    alignment: center;

                    FilledButton {
                        text: root.action_text;

                        clicked => {
                            root.accepted();
                        }
                    }
                }
            }

            ScrollView {
                vertical_stretch: 1;

                VerticalLayout {
                    padding: root.floating ? MaterialStyleMetrics.padding_24 : MaterialStyleMetrics.padding_16;
                    // Short forms keep their natural heights instead of stretching to fill the card.
                    alignment: start;
                    padding_top: 0;
                    spacing: MaterialStyleMetrics.spacing_16;

                    @children
                }
            }
        }
    }

    Timer {
        interval: 50ms;

        triggered => {
            panel.opacity = 1;
            self.running = false;
        }
    }
}
