import { MaterialStyleMetrics, ScrollView, TextField } from "@material";
import { App } from "../app.slint";
import { PickerPurpose } from "../types.slint";
import { Tile } from "tile.slint";

// A filterable list of candidate items; `picked` fires with the chosen id.
export component ItemPicker inherits Rectangle {
    in property <PickerPurpose> purpose;
    in property <string> context_id;

    callback picked(id: string, title: string);

    min_height: MaterialStyleMetrics.size_256;

    in_out property <string> filter <=> filter_field.text;

    VerticalLayout {
        spacing: MaterialStyleMetrics.spacing_8;

        filter_field := TextField {
            label: @tr("Search");

            edited(text) => {
                App.picker_query(root.purpose, text, root.context_id);
            }
        }

        ScrollView {
            VerticalLayout {
                for row in App.picker_rows: Tile {
                    text: row.title;
                    supporting_text: row.path;

                    clicked => {
                        root.picked(row.id, row.title);
                    }
                }
            }
        }
    }
}
