import {
    Elevation,
    FilledButton,
    Icon,
    MaterialAnimations,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    TextButton,
} from "@material";
import { ErrorBanner } from "error_banner.slint";

// A compact prompt shell: a centered card over a scrim, styled like FormDialog. Escape closes it; Return accepts.
export component PromptDialog inherits PopupWindow {
    in property <string> title;
    in property <image> icon;
    in property <string> error;
    in property <string> action_text;
    in property <string> cancel_text: @tr("Cancel");
    // Close on a tap outside the card; off for dialogs with input, so a mis-tap cannot drop it.
    in property <bool> dismissible;

    callback accepted();
    // The secondary button; the dialog closes right after it.
    callback cancelled();

    close_policy: no_auto_close;
    forward_focus: focus_scope;

    focus_scope := FocusScope {
        x: 0;
        width: 0;

        key_pressed(event) => {
            if event.text == Key.Return && root.action_text != "" {
                root.accepted();
                return accept;
            }
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: MaterialPalette.background_modal;

        TouchArea {
            clicked => {
                if root.dismissible {
                    root.close();
                }
            }
        }
    }

    panel := Elevation {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(MaterialStyleMetrics.size_572, root.width - 2 * MaterialStyleMetrics.padding_24);
        height: min(layout.preferred_height, root.height - 2 * MaterialStyleMetrics.padding_24);
        level: 3;
        border_radius: MaterialStyleMetrics.border_radius_28;
        background: MaterialPalette.surface_container_high;
        opacity: 0;

        animate opacity {
            duration: MaterialAnimations.opacity_duration;
            easing: MaterialAnimations.opacity_easing;
        }

        TouchArea { }

        layout := VerticalLayout {
            padding: MaterialStyleMetrics.padding_24;
            spacing: MaterialStyleMetrics.spacing_16;

            if root.icon.width > 0: HorizontalLayout {
                alignment: center;

                Icon {
                    source: root.icon;
                    width: MaterialStyleMetrics.icon_size_24;
                    colorize: MaterialPalette.secondary;
                }
            }

            if root.title != "": MaterialText {
                text: root.title;
                wrap: word_wrap;
                horizontal_alignment: root.icon.width > 0 ? center : left;
                style: MaterialTypography.headline_small;
                color: MaterialPalette.on_surface;
            }

            if root.error != "": ErrorBanner {
                text: root.error;
            }

            @children

            if root.action_text != "" || root.cancel_text != "": HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                Rectangle { }

                if root.cancel_text != "": TextButton {
                    text: root.cancel_text;

                    clicked => {
                        root.cancelled();
                        root.close();
                    }
                }

                if root.action_text != "": FilledButton {
                    text: root.action_text;

                    clicked => {
                        root.accepted();
                    }
                }
            }
        }
    }

    Timer {
        interval: 50ms;

        triggered => {
            panel.opacity = 1;
            self.running = false;
        }
    }
}
