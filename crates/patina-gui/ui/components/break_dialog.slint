import { MaterialPalette, MaterialText, MaterialTypography } from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { Labels } from "../labels.slint";
import { RhythmModeUi } from "../types.slint";
import { PromptDialog } from "prompt_dialog.slint";

export component BreakDialog inherits Rectangle {
    width: 0;
    height: 0;

    public function open() {
        dlg.show();
    }

    dlg := PromptDialog {
        x: -root.absolute_position.x;
        y: -root.absolute_position.y;
        width: App.window_width;
        height: App.window_height;
        title: @tr("Time for a break");
        icon: AppIcons.coffee;
        cancel_text: App.rhythm.mode == RhythmModeUi.flowtime ? @tr("Not now") : @tr("10 more minutes");
        action_text: @tr("Start break");

        accepted => {
            App.start_break();
            dlg.close();
        }
        cancelled => {
            App.snooze_break();
        }

        MaterialText {
            text: @tr("You've focused {} min. Take a {}-min {} break?", App.prompt.focus_minutes, App.prompt.minutes, Labels.break_kind(App.prompt.break_kind));
            wrap: word_wrap;
            overflow: clip;
            style: MaterialTypography.body_medium;
            color: MaterialPalette.on_surface_variant;
        }
    }
}
