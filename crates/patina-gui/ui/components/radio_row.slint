import {
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    RadioButton,
    StateLayerArea,
    MaterialPalette,
} from "@material";

// A labelled radio button. Material's tile variant sizes itself from its content, which
// loops inside dialogs, so this one has a fixed height.
export component RadioRow inherits Rectangle {
    in property <string> text;
    in property <bool> checked;

    callback clicked();

    min_height: MaterialStyleMetrics.size_48;

    StateLayerArea {
        color: MaterialPalette.on_surface;
        clicked => {
            root.clicked();
        }

        HorizontalLayout {
            padding_left: MaterialStyleMetrics.padding_8;
            spacing: MaterialStyleMetrics.spacing_8;

            RadioButton {
                checked: root.checked;

                clicked => {
                    root.clicked();
                }
            }

            MaterialText {
                text: root.text;
                vertical_alignment: center;
                style: MaterialTypography.body_large;
            }
        }
    }
}
