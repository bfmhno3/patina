import {
    FloatingActionButton,
    IconButton,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    Switch,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { ItemFormDialog } from "../components/item_form_dialog.slint";
import { EmptyState } from "../components/empty_state.slint";
import { ItemTile } from "../components/item_tile.slint";
import { PageHeader } from "../components/page_header.slint";
import { PageScroll } from "../components/page_scroll.slint";
import { Section } from "../components/section.slint";

export component ProjectsPage inherits Rectangle {
    PageScroll {
        bottom_space: MaterialStyleMetrics.size_90;

        PageHeader {
            title: @tr("Projects");

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;
                alignment: center;

                MaterialText {
                    text: @tr("Show settled");
                    vertical_alignment: center;
                    style: MaterialTypography.body_medium;
                }

                VerticalLayout {
                    alignment: center;

                    Switch {
                        checked: App.show_settled;

                        checked_state_changed(checked) => {
                            App.set_show_settled(checked);
                        }
                    }
                }
            }
        }

        if App.tree.length > 0: Section {
            for r[i] in App.tree: ItemTile {
                data: r;
                divider: i > 0;

                clicked => {
                    App.open_item(r.id);
                }

                if r.depth == 0 && r.children > 0: IconButton {
                    icon: AppIcons.account_tree;
                    tooltip: @tr("Graph");

                    clicked => {
                        App.open_graph(r.id);
                    }
                }
            }
        }

        if App.tree.length == 0: EmptyState {
            icon: AppIcons.account_tree;
            title: @tr("No projects yet");
            text: @tr("Create one with New item.");
        }
    }

    FloatingActionButton {
        x: root.width - self.width - MaterialStyleMetrics.padding_16;
        y: root.height - self.height - MaterialStyleMetrics.padding_16;
        icon: AppIcons.add;
        text: @tr("New item");

        clicked => {
            form.open(0, "", App.blank_form("", App.mode_identity, ""), "");
        }
    }

    form := ItemFormDialog { }
}
