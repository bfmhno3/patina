import {
    FilledButton,
    Icon,
    IconButton,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    PopupMenu,
    TextField,
    TonalButton,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { Labels } from "../labels.slint";
import { AbandonDialog } from "../components/abandon_dialog.slint";
import { InfoCard } from "../components/info_card.slint";
import { ItemFormDialog } from "../components/item_form_dialog.slint";
import { ItemPickerDialog } from "../components/item_picker_dialog.slint";
import { ItemTile } from "../components/item_tile.slint";
import { PageScroll } from "../components/page_scroll.slint";
import { PropertyRow } from "../components/property_row.slint";
import { Section } from "../components/section.slint";
import { StuckDialog } from "../components/stuck_dialog.slint";
import { TextPromptDialog } from "../components/text_prompt_dialog.slint";
import { ItemForm, PickerPurpose } from "../types.slint";

export component ItemPage inherits Rectangle {
    property <string> note_error;
    property <string> action_error;

    function edit_form() -> ItemForm {
        return {
            title: App.detail.item.title,
            identity: App.detail.item.identity,
            parent_id: App.detail.parent_id,
            tags: App.detail.tags_raw,
            defer: App.detail.defer,
            scheduled: App.detail.item.scheduled,
            deadline: App.detail.item.deadline,
            waiting_for: App.detail.waiting_for,
            follow_up: App.detail.follow_up,
            size: App.detail.size,
            repeat_kind: App.detail.repeat_kind,
            repeat_n: App.detail.repeat_n,
            repeat_unit: App.detail.repeat_unit,
            important: App.detail.item.important,
        };
    }

    PageScroll {
        HorizontalLayout {
            min_height: MaterialStyleMetrics.size_64;
            spacing: MaterialStyleMetrics.spacing_8;

            VerticalLayout {
                alignment: center;

                IconButton {
                    icon: App.two_pane ? AppIcons.close : AppIcons.arrow_back;
                    tooltip: App.two_pane ? @tr("Close") : @tr("Back");

                    clicked => {
                        App.close_detail();
                    }
                }
            }

            Rectangle { }

            if App.detail.settled == "": VerticalLayout {
                alignment: center;

                IconButton {
                    icon: AppIcons.edit;
                    tooltip: @tr("Edit…");

                    clicked => {
                        form.open(3, App.detail.item.id, root.edit_form(), "");
                    }
                }
            }

            if App.detail.settled == "": VerticalLayout {
                alignment: center;

                IconButton {
                    icon: AppIcons.more_vert;
                    tooltip: @tr("More");

                    clicked => {
                        more.show();
                    }
                }
            }
        }

        VerticalLayout {
            spacing: MaterialStyleMetrics.spacing_4;

            if App.detail.item.path != "": MaterialText {
                text: App.detail.item.path;
                color: MaterialPalette.on_surface_variant;
                style: MaterialTypography.label_large;
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                if App.detail.item.important: VerticalLayout {
                    alignment: center;

                    Icon {
                        source: AppIcons.star;
                        width: MaterialStyleMetrics.icon_size_24;
                        colorize: MaterialPalette.tertiary;
                    }
                }

                MaterialText {
                    text: App.detail.item.title;
                    horizontal_stretch: 1;
                    wrap: word_wrap;
                    overflow: clip;
                    style: MaterialTypography.headline_small;
                }
            }

            MaterialText {
                text: Labels.status(App.detail.item.status);
                color: MaterialPalette.on_surface_variant;
                style: MaterialTypography.label_large;
            }
        }

        if App.detail.settled == "": HorizontalLayout {
            alignment: start;
            spacing: MaterialStyleMetrics.spacing_8;

            if !App.detail.is_external: FilledButton {
                text: @tr("Start");
                icon: AppIcons.play_arrow;

                clicked => {
                    App.start_timer(App.detail.item.id);
                }
            }

            TonalButton {
                text: @tr("Done…");
                icon: AppIcons.check;

                clicked => {
                    complete.open("");
                }
            }
        }

        if root.action_error != "": MaterialText {
            text: root.action_error;
            wrap: word_wrap;
            overflow: clip;
            color: MaterialPalette.error;
        }

        if App.detail.left_off != "": InfoCard {
            icon: AppIcons.lightbulb;
            tone_background: MaterialPalette.tertiary_container;
            tone_foreground: MaterialPalette.on_tertiary_container;

            MaterialText {
                text: @tr("Left off: {}", App.detail.left_off);
                wrap: word_wrap;
                overflow: clip;
                style: MaterialTypography.body_medium;
                color: MaterialPalette.on_tertiary_container;
            }
        }

        if App.detail.settled != "": InfoCard {
            icon: App.detail.item.status == "done" ? AppIcons.check_circle : AppIcons.block;
            tone_background: MaterialPalette.surface_container_high;
            tone_foreground: MaterialPalette.on_surface;

            MaterialText {
                text: (App.detail.item.status == "done" ? @tr("Completed {}", App.detail.settled) : @tr("Abandoned {}", App.detail.settled))
                    + (App.detail.completion_note != "" ? " · " + App.detail.completion_note : "")
                    + (App.detail.abandon_reason != "" ? " · " + Labels.abandon_reason(Math.round(App.detail.abandon_reason.to_float())) : "")
                    + (App.detail.abandon_note != "" ? " · " + App.detail.abandon_note : "");
                wrap: word_wrap;
                overflow: clip;
                style: MaterialTypography.body_medium;
                color: MaterialPalette.on_surface;
            }
        }

        Section {
            title: @tr("Details");

            PropertyRow {
                icon: AppIcons.person;
                label: @tr("Identity");
                value: App.detail.item.identity;
            }

            if App.detail.item.deadline != "": PropertyRow {
                icon: AppIcons.event;
                label: @tr("Due");
                value: App.detail.item.deadline;
                divider: true;
            }

            if App.detail.item.scheduled != "": PropertyRow {
                icon: AppIcons.today;
                label: @tr("Planned");
                value: App.detail.item.scheduled;
                divider: true;
            }

            if App.detail.defer != "": PropertyRow {
                icon: AppIcons.visibility_off;
                label: @tr("Hidden until");
                value: App.detail.defer;
                divider: true;
            }

            if App.detail.waiting_for != "": PropertyRow {
                icon: AppIcons.hourglass_empty;
                label: @tr("Waiting for");
                value: App.detail.waiting_for;
                divider: true;
            }

            if App.detail.follow_up != "": PropertyRow {
                icon: AppIcons.schedule;
                label: @tr("Follow up");
                value: App.detail.follow_up;
                divider: true;
            }

            if App.detail.tags_raw != "": PropertyRow {
                icon: AppIcons.sell;
                label: @tr("Tags");
                value: App.detail.tags_raw;
                divider: true;
            }

            PropertyRow {
                icon: AppIcons.straighten;
                label: @tr("Estimate");
                value: Labels.size(App.detail.size) + (App.detail.item.estimate_minutes > 0 ? " · " + Labels.minutes(App.detail.item.estimate_minutes) : "") + (App.detail.children_estimate_minutes >= 0 ? " · " + @tr("children {}", Labels.minutes(App.detail.children_estimate_minutes)) : "");
                divider: true;
            }

            PropertyRow {
                icon: AppIcons.timer;
                label: @tr("Tracked");
                value: Labels.minutes(App.detail.item.tracked_minutes);
                divider: true;
            }

            if App.detail.repeat_kind != 0: PropertyRow {
                icon: AppIcons.event_repeat;
                label: @tr("Repeats");
                value: App.detail.repeat_kind == 1 ? @tr("Repeats every {} {}", App.detail.repeat_n, Labels.repeat_unit(App.detail.repeat_unit)) : @tr("Repeats {} days after completion", App.detail.repeat_n);
                divider: true;
            }
        }

        Section {
            title: @tr("Notes");

            for note[i] in App.detail.notes: Rectangle {
                if i > 0: Rectangle {
                    y: 0;
                    height: MaterialStyleMetrics.size_1;
                    background: MaterialPalette.outline_variant;
                }

                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_2;

                    MaterialText {
                        text: note.day;
                        color: MaterialPalette.on_surface_variant;
                        style: MaterialTypography.label_medium;
                    }

                    MaterialText {
                        text: note.text;
                        wrap: word_wrap;
                        overflow: clip;
                        style: MaterialTypography.body_medium;
                    }
                }
            }
        }

        TextField {
            label: @tr("Add a note");
            has_error: root.note_error != "";
            supporting_text: root.note_error;

            accepted(text) => {
                if text != "" {
                    root.note_error = App.add_note(App.detail.item.id, text);
                    if root.note_error == "" {
                        self.text = "";
                    }
                }
            }
        }

        if App.detail.prerequisites.length > 0: Section {
            title: @tr("Depends on");

            for r[i] in App.detail.prerequisites: ItemTile {
                data: r;
                actions: false;
                divider: i > 0;

                clicked => {
                    App.open_item(r.id);
                }

                IconButton {
                    icon: AppIcons.link_off;
                    tooltip: @tr("Unlink");

                    clicked => {
                        App.unlink(App.detail.item.id, r.id);
                    }
                }
            }
        }

        if App.detail.dependents.length > 0: Section {
            title: @tr("Blocks");

            for r[i] in App.detail.dependents: ItemTile {
                data: r;
                actions: false;
                divider: i > 0;

                clicked => {
                    App.open_item(r.id);
                }
            }
        }

        if App.detail.children.length > 0: Section {
            title: @tr("Sub-items");

            for r[i] in App.detail.children: ItemTile {
                data: r;
                divider: i > 0;

                clicked => {
                    App.open_item(r.id);
                }
            }
        }
    }

    more := PopupMenu {
        x: root.width - self.width - MaterialStyleMetrics.padding_16;
        y: MaterialStyleMetrics.size_56;
        items: [
            { text: @tr("Mark as started"), enabled: App.detail.item.status == "todo" },
            { text: @tr("Add sub-item…"), enabled: !App.detail.is_external },
            { text: @tr("Move…"), enabled: true },
            { text: @tr("Move to top level"), enabled: App.detail.parent_id != "" },
            { text: @tr("Depends on…"), enabled: true },
            { text: @tr("Stuck…"), enabled: !App.detail.is_external },
            { text: @tr("Abandon…"), enabled: true },
            { text: @tr("Show graph"), enabled: App.detail.item.children > 0 },
        ];

        activated(index) => {
            more.close();
            if index == 0 {
                App.mark_started(App.detail.item.id);
            } else if index == 1 {
                form.open(1, "", App.blank_form("", App.detail.item.identity, App.detail.item.id), App.detail.item.title);
            } else if index == 2 {
                move_picker.open();
            } else if index == 3 {
                root.action_error = App.move_item(App.detail.item.id, "");
            } else if index == 4 {
                link_picker.open();
            } else if index == 5 {
                stuck.open(App.detail.item.id);
            } else if index == 6 {
                abandon.open(App.detail.item.id);
            } else {
                App.open_graph(App.detail.item.id);
            }
        }
    }

    complete := TextPromptDialog {
        title: @tr("Complete");
        label: @tr("Note (optional)");
        action_text: @tr("Done");

        submitted(text) => {
            return App.complete(App.detail.item.id, text);
        }
    }

    form := ItemFormDialog { }

    abandon := AbandonDialog { }

    stuck := StuckDialog { }

    move_picker := ItemPickerDialog {
        title: @tr("Move under…");
        purpose: PickerPurpose.parent;
        context_id: App.detail.item.id;

        picked(id) => {
            root.action_error = App.move_item(App.detail.item.id, id);
        }
    }

    link_picker := ItemPickerDialog {
        title: @tr("Depends on…");
        purpose: PickerPurpose.link;
        context_id: App.detail.item.id;

        picked(id) => {
            root.action_error = App.link(App.detail.item.id, id);
        }
    }
}
