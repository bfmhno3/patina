import {
    CheckBox,
    CheckState,
    FilledButton,
    Icon,
    IconButton,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    TextButton,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { Labels } from "../labels.slint";
import { EmptyState } from "../components/empty_state.slint";
import { ErrorBanner } from "../components/error_banner.slint";
import { ItemFormDialog } from "../components/item_form_dialog.slint";
import { ItemPickerDialog } from "../components/item_picker_dialog.slint";
import { PageHeader } from "../components/page_header.slint";
import { PageScroll } from "../components/page_scroll.slint";
import { Section } from "../components/section.slint";
import { PickerPurpose } from "../types.slint";
import { Tile } from "../components/tile.slint";

export component InboxPage inherits Rectangle {
    property <string> merge_source;
    property <string> merge_text;
    property <string> error;
    property <string> proposal_error;

    PageScroll {
        PageHeader {
            title: @tr("Inbox");
            subtitle: App.inbox.length > 0 ? @tr("{} to triage", App.inbox.length) : "";
        }

        if root.proposal_error != "": ErrorBanner {
            text: root.proposal_error;
        }

        if App.proposals.length > 0: Section {
            title: @tr("Proposals");

            for p[i] in App.proposals: VerticalLayout {
                if i > 0: Rectangle {
                    height: MaterialStyleMetrics.size_1;
                    background: MaterialPalette.outline_variant;
                }

                VerticalLayout {
                    padding: MaterialStyleMetrics.padding_16;
                    spacing: MaterialStyleMetrics.spacing_8;

                    HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_12;

                        VerticalLayout {
                            alignment: start;

                            Icon {
                                source: AppIcons.smart_toy;
                                width: MaterialStyleMetrics.icon_size_24;
                                colorize: MaterialPalette.primary;
                            }
                        }

                        VerticalLayout {
                            horizontal_stretch: 1;

                            MaterialText {
                                text: p.summary;
                                wrap: word_wrap;
                                overflow: clip;
                                style: MaterialTypography.title_medium;
                            }

                            MaterialText {
                                text: p.source + " · " + p.submitted;
                                color: MaterialPalette.on_surface_variant;
                                style: MaterialTypography.body_small;
                            }
                        }
                    }

                    for u in p.units: HorizontalLayout {
                        spacing: MaterialStyleMetrics.spacing_8;

                        CheckBox {
                            check_state: u.checked ? CheckState.checked : CheckState.unchecked;
                            enabled: u.state == "ready";
                            vertical_stretch: 0;

                            checked_state_changed(state) => {
                                App.toggle_unit(p.id, u.index);
                            }
                        }

                        VerticalLayout {
                            horizontal_stretch: 1;
                            alignment: center;

                            MaterialText {
                                text: @tr("Part {}", u.index + 1);
                                style: MaterialTypography.label_large;
                            }

                            for c in u.changes: VerticalLayout {
                                MaterialText {
                                    text: Labels.change(c);
                                    wrap: word_wrap;
                                    overflow: clip;
                                    style: MaterialTypography.body_medium;
                                }

                                for f in c.fields: MaterialText {
                                    text: Labels.field(f.field) + ": " + f.old + " → " + f.new;
                                    wrap: word_wrap;
                                    overflow: clip;
                                    style: MaterialTypography.body_small;
                                }
                            }

                            if u.needs != "": MaterialText {
                                text: @tr("Needs parts {}", u.needs);
                                style: MaterialTypography.body_small;
                            }

                            if u.state == "stale": MaterialText {
                                text: @tr("Out of date: {}", u.problem);
                                wrap: word_wrap;
                                overflow: clip;
                                color: MaterialPalette.error;
                                style: MaterialTypography.body_small;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: MaterialStyleMetrics.spacing_8;

                        TextButton {
                            text: @tr("Reject");

                            clicked => {
                                root.proposal_error = App.reject_proposal(p.id);
                            }
                        }

                        FilledButton {
                            text: @tr("Accept selected");

                            clicked => {
                                root.proposal_error = App.accept_proposal(p.id);
                            }
                        }
                    }
                }
            }
        }

        if root.error != "": ErrorBanner {
            text: root.error;
        }

        if App.inbox.length > 0: Section {
            for entry[i] in App.inbox: Tile {
                leading_icon: AppIcons.lightbulb;
                divider: i > 0;
                text: entry.text;
                supporting_text: entry.captured + (entry.identity_hint != "" ? " · " + entry.identity_hint : "");

                IconButton {
                    icon: AppIcons.edit;
                    tooltip: @tr("Triage");

                    clicked => {
                        form.open(2, entry.id, App.blank_form(entry.text, entry.identity_hint != "" ? entry.identity_hint : App.mode_identity, ""), "");
                    }
                }

                IconButton {
                    icon: AppIcons.merge;
                    tooltip: @tr("Merge into…");

                    clicked => {
                        root.merge_source = entry.id;
                        root.merge_text = entry.text;
                        picker.open();
                    }
                }

                IconButton {
                    icon: AppIcons.delete;
                    tooltip: @tr("Discard");

                    clicked => {
                        App.discard(entry.id);
                    }
                }
            }
        }

        if App.inbox.length == 0: EmptyState {
            icon: AppIcons.inbox;
            title: @tr("Inbox zero");
            text: @tr("The inbox is empty. Capture a thought above.");
        }
    }

    form := ItemFormDialog { }

    picker := ItemPickerDialog {
        title: @tr("Merge into…");
        purpose: PickerPurpose.merge_into;
        context_id: root.merge_source;
        subject: @tr("“{}” becomes a note on the item you pick", root.merge_text);
        subject_icon: AppIcons.merge;
        empty_text: @tr("There are no open items to merge into.");

        picked(id, title) => {
            root.error = App.merge(root.merge_source, id);
        }
    }
}
