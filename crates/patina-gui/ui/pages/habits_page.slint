import {
    FloatingActionButton,
    MaterialStyleMetrics,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { CheckInDialog } from "../components/check_in_dialog.slint";
import { EmptyState } from "../components/empty_state.slint";
import { HabitFormDialog } from "../components/habit_form_dialog.slint";
import { HabitTile } from "../components/habit_tile.slint";
import { PageHeader } from "../components/page_header.slint";
import { PageScroll } from "../components/page_scroll.slint";
import { Section } from "../components/section.slint";

export component HabitsPage inherits Rectangle {
    PageScroll {
        bottom_space: MaterialStyleMetrics.size_90;

        PageHeader {
            title: @tr("Habits");
        }

        if App.habits.length == 0: EmptyState {
            icon: AppIcons.event_repeat;
            title: @tr("No habits yet.");
            text: @tr("Build one with New habit.");
        }

        if App.habits.length > 0: Section {
            for r[i] in App.habits: HabitTile {
                data: r;
                detailed: true;
                divider: i > 0;

                check_in_requested => {
                    check_in.open(r, false);
                }
                skip_requested => {
                    check_in.open(r, true);
                }
                edit_requested => {
                    form.open_edit(r);
                }
            }
        }

        if App.graduated_habits.length > 0: Section {
            title: @tr("Graduated");

            for r[i] in App.graduated_habits: HabitTile {
                data: r;
                detailed: true;
                divider: i > 0;

                edit_requested => {
                    form.open_edit(r);
                }
            }
        }
    }

    FloatingActionButton {
        x: root.width - self.width - MaterialStyleMetrics.padding_16;
        y: root.height - self.height - MaterialStyleMetrics.padding_16;
        icon: AppIcons.add;
        text: @tr("New habit");

        clicked => {
            form.open_new(App.mode_identity);
        }
    }

    check_in := CheckInDialog { }

    form := HabitFormDialog { }
}
