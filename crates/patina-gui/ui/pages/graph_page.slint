import {
    IconButton,
    MaterialPalette,
    MaterialStyleMetrics,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { EmptyState } from "../components/empty_state.slint";
import { GraphNode } from "../components/graph_node.slint";
import { PageHeader } from "../components/page_header.slint";

// The children of one composite item as a layered dependency graph.
export component GraphPage inherits Rectangle {
    VerticalLayout {
        padding_left: App.wide ? MaterialStyleMetrics.padding_24 : MaterialStyleMetrics.padding_16;
        padding_right: App.wide ? MaterialStyleMetrics.padding_24 : MaterialStyleMetrics.padding_16;
        padding_bottom: MaterialStyleMetrics.padding_16;
        spacing: MaterialStyleMetrics.spacing_8;

        PageHeader {
            title: App.graph.root_title;
            leading_icon: AppIcons.arrow_back;
            leading_tooltip: @tr("Back");

            leading_clicked => {
                App.close_graph();
            }

            if App.graph.parent_id != "": VerticalLayout {
                alignment: center;

                IconButton {
                    icon: AppIcons.arrow_upward;
                    tooltip: @tr("Up to parent");

                    clicked => {
                        App.open_graph(App.graph.parent_id);
                    }
                }
            }
        }

        if App.graph.nodes.length == 0: EmptyState {
            icon: AppIcons.account_tree;
            title: @tr("No sub-items.");
            text: "";
        }

        if App.graph.nodes.length > 0: Flickable {
            vertical_stretch: 1;
            content_width: max(App.graph.width, self.width);
            content_height: max(App.graph.height, self.height);

            if App.graph.edges != "": Path {
                x: 0;
                y: 0;
                width: App.graph.width;
                height: App.graph.height;
                viewbox_x: 0;
                viewbox_y: 0;
                viewbox_width: App.graph.width / 1px;
                viewbox_height: App.graph.height / 1px;
                commands: App.graph.edges;
                stroke: MaterialPalette.outline_variant;
                stroke_width: 1.5px;
            }

            for n in App.graph.nodes: GraphNode {
                data: n;
            }
        }
    }
}
