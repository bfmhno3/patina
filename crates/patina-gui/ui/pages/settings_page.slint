import { AboutSlint } from "std-widgets.slint";
import {
    FilledButton,
    IconButton,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    TextButton,
    TonalButton,
} from "@material";
import { App } from "../app.slint";
import { AppIcons } from "../icons.slint";
import { Labels } from "../labels.slint";
import { ChoiceRow } from "../components/choice_row.slint";
import { PageHeader } from "../components/page_header.slint";
import { PageScroll } from "../components/page_scroll.slint";
import { PropertyRow } from "../components/property_row.slint";
import { Section } from "../components/section.slint";
import { TextPromptDialog } from "../components/text_prompt_dialog.slint";
import { RhythmModeUi, StorageUi } from "../types.slint";
import { Tile } from "../components/tile.slint";

export component SettingsPage inherits Rectangle {
    property <string> sources_error;
    property <string> target_for;
    property <string> rhythm_value: Labels.rhythm_mode(App.rhythm.mode);

    PageScroll {
        PageHeader {
            title: @tr("Settings");
            leading_icon: AppIcons.arrow_back;
            leading_tooltip: @tr("Back");

            leading_clicked => {
                App.close_settings();
            }
        }

        Section {
            title: @tr("Identities");

            for identity[i] in App.identity_rows: Tile {
                leading_icon: AppIcons.person;
                divider: i > 0;
                text: identity.name;
                supporting_text: (identity.target != "" ? @tr("target {} h/week", identity.target) + " · " : "") + @tr("{} open items, {} habits", identity.open_items, identity.habits);

                IconButton {
                    icon: AppIcons.edit;
                    tooltip: @tr("Rename");

                    clicked => {
                        root.target_for = identity.name;
                        rename.open(identity.name);
                    }
                }

                IconButton {
                    icon: AppIcons.star;
                    tooltip: @tr("Weekly target");

                    clicked => {
                        root.target_for = identity.name;
                        target.open(identity.target);
                    }
                }
            }

            Tile {
                leading_icon: AppIcons.add;
                divider: App.identity_rows.length > 0;
                text: @tr("Add identity");

                clicked => {
                    add.open("");
                }
            }
        }

        Section {
            title: @tr("Break reminders");

            VerticalLayout {
                padding: MaterialStyleMetrics.padding_16;
                spacing: MaterialStyleMetrics.spacing_8;

                ChoiceRow {
                    options: [
                        Labels.rhythm_mode(RhythmModeUi.fixed),
                        Labels.rhythm_mode(RhythmModeUi.flowtime),
                        Labels.rhythm_mode(RhythmModeUi.off)
                    ];
                    by_value: true;
                    value <=> root.rhythm_value;

                    chosen(index) => {
                        App.set_rhythm(index == 0 ? RhythmModeUi.fixed : index == 1 ? RhythmModeUi.flowtime : RhythmModeUi.off);
                    }
                }

                MaterialText {
                    text: @tr("Focus {} min, short break {} min, long break {} min after {} rounds. Flowtime: one break minute per {} focus minutes. Snooze {} min. Edit config.toml to change these.", App.settings.focus_minutes, App.settings.short_break, App.settings.long_break, App.settings.rounds, App.settings.flow_ratio, App.settings.snooze);
                    wrap: word_wrap;
                    overflow: clip;
                    color: MaterialPalette.on_surface_variant;
                    style: MaterialTypography.body_medium;
                }
            }
        }

        Section {
            title: @tr("Data");

            PropertyRow {
                icon: AppIcons.folder;
                label: @tr("Location");
                value: App.settings.root;
            }

            PropertyRow {
                icon: AppIcons.devices;
                label: @tr("Device");
                value: App.settings.device;
                divider: true;
            }

            VerticalLayout {
                padding: MaterialStyleMetrics.padding_16;
                spacing: MaterialStyleMetrics.spacing_8;

                if App.settings.storage == StorageUi.private: MaterialText {
                    text: @tr("Stored privately on this device. To sync with Syncthing, allow \"All files access\" for Patina in Android settings and restart; the data then moves to Documents/Patina.");
                    wrap: word_wrap;
                    overflow: clip;
                    color: MaterialPalette.on_surface_variant;
                    style: MaterialTypography.body_small;
                }

                if App.settings.storage == StorageUi.shared: MaterialText {
                    text: @tr("Stored in Documents/Patina. Sync events/ and config.toml with Syncthing; the device id stays private.");
                    wrap: word_wrap;
                    overflow: clip;
                    color: MaterialPalette.on_surface_variant;
                    style: MaterialTypography.body_small;
                }

                HorizontalLayout {
                    alignment: start;

                    TonalButton {
                        text: @tr("Undo last command");
                        icon: AppIcons.undo;

                        clicked => {
                            App.undo();
                        }
                    }
                }
            }
        }

        if root.sources_error != "": MaterialText {
            text: root.sources_error;
            wrap: word_wrap;
            overflow: clip;
            color: MaterialPalette.error;
            style: MaterialTypography.body_medium;
        }

        Section {
            title: @tr("AI changes");

            if App.settings.sources.length == 0: VerticalLayout {
                padding: MaterialStyleMetrics.padding_16;

                MaterialText {
                    text: @tr("No AI changes to undo.");
                    color: MaterialPalette.on_surface_variant;
                    style: MaterialTypography.body_medium;
                }
            }

            for s[i] in App.settings.sources: Tile {
                leading_icon: AppIcons.smart_toy;
                divider: i > 0;
                text: s.source;
                supporting_text: @tr("{} commands, last {}", s.commands, s.last);

                TextButton {
                    text: @tr("Undo all");

                    clicked => {
                        root.sources_error = App.undo_source(s.source);
                    }
                }
            }
        }

        Section {
            title: @tr("About");

            VerticalLayout {
                padding: MaterialStyleMetrics.padding_16;
                spacing: MaterialStyleMetrics.spacing_8;

                MaterialText {
                    text: @tr("Patina {}", App.settings.version);
                    style: MaterialTypography.body_large;
                }

                // Slint Royalty-free License attribution; never remove.
                AboutSlint { }
            }
        }
    }

    rename := TextPromptDialog {
        title: @tr("Rename identity");
        label: @tr("Name");

        submitted(text) => {
            return App.rename_identity(root.target_for, text);
        }
    }

    add := TextPromptDialog {
        title: @tr("New identity");
        label: @tr("Name");
        action_text: @tr("Add");

        submitted(text) => {
            return App.add_identity(text);
        }
    }

    target := TextPromptDialog {
        title: @tr("Weekly target");
        label: @tr("Hours per week");
        hint: @tr("A number like 20 or 7.5, or none");

        submitted(text) => {
            return App.set_target(root.target_for, text);
        }
    }
}
