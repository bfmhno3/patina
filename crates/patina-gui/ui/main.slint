import {
    IconButton,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialWindow,
    NavigationBar,
    NavigationItem,
    NavigationRail,
    TonalButton,
} from "@material";
import { App } from "app.slint";
import { AppIcons } from "icons.slint";
import { BreakDialog } from "components/break_dialog.slint";
import { CaptureBar } from "components/capture_bar.slint";
import { ModeDialog } from "components/mode_dialog.slint";
import { NoticeBar } from "components/notice_bar.slint";
import { StatusStrip } from "components/status_strip.slint";
import { Theme } from "theme.slint";
import { TimeCorrectionDialog } from "components/time_correction_dialog.slint";
import { HabitsPage } from "pages/habits_page.slint";
import { InboxPage } from "pages/inbox_page.slint";
import { GraphPage } from "pages/graph_page.slint";
import { ItemPage } from "pages/item_page.slint";
import { ProjectsPage } from "pages/projects_page.slint";
import { ReviewPage } from "pages/review_page.slint";
import { SettingsPage } from "pages/settings_page.slint";
import { TodayPage } from "pages/today_page.slint";
import { PromptKind } from "types.slint";

export { MaterialWindowAdapter, DatePickerAdapter } from "@material";
export { App } from "app.slint";
export { AppIcons } from "icons.slint";
export { Labels } from "labels.slint";
export * from "types.slint";

export component MainWindow inherits MaterialWindow {
    title: @tr("Patina");
    preferred_width: 960px;
    preferred_height: 720px;
    min_width: 360px;

    property <bool> two_pane: App.two_pane;
    property <bool> full_detail: App.detail_open && !App.two_pane;
    property <int> prompt_seq: App.prompt.seq;
    property <int> notice_seq: App.notice.seq;
    property <[NavigationItem]> nav_items: [
        {
            icon: AppIcons.today,
            selected_icon: AppIcons.today,
            text: @tr("Today"),
            show_badge: false,
            badge: ""
        },
        {
            icon: AppIcons.inbox,
            selected_icon: AppIcons.inbox,
            text: @tr("Inbox"),
            show_badge: App.today.inbox + App.today.proposals > 0,
            badge: App.today.inbox + App.today.proposals
        },
        {
            icon: AppIcons.account_tree,
            selected_icon: AppIcons.account_tree,
            text: @tr("Projects"),
            show_badge: false,
            badge: ""
        },
        {
            icon: AppIcons.event_repeat,
            selected_icon: AppIcons.event_repeat,
            text: @tr("Habits"),
            show_badge: false,
            badge: ""
        },
        {
            icon: AppIcons.rate_review,
            selected_icon: AppIcons.rate_review,
            text: @tr("Review"),
            show_badge: App.today.review_due,
            badge: ""
        },
    ];

    init => {
        MaterialPalette.schemes = Theme.schemes;
        App.window_width = root.width;
        App.window_height = root.height;
    }

    changed width => {
        App.window_width = root.width;
    }

    changed height => {
        App.window_height = root.height;
    }

    changed two_pane => {
        App.refresh();
    }

    changed prompt_seq => {
        if App.prompt.kind == PromptKind.break_due {
            break_dialog.open();
        } else if App.prompt.kind != PromptKind.none {
            correction.open();
        }
    }

    changed notice_seq => {
        notice.show();
    }

    HorizontalLayout {
        if App.wide: NavigationRail {
            alignment: start;
            horizontal_stretch: 0;
            items: root.nav_items;
            current_index <=> App.page;

            index_changed(index) => {
                App.navigate(index);
            }
        }

        VerticalLayout {
            horizontal_stretch: 1;

            // When wide, the rail already gives the left margin.
            // z: top-bar tooltips hang below the bar and must paint over the status strip and the page.
            Rectangle {
                z: 1;

                VerticalLayout {
                    padding_left: App.wide ? 0px : MaterialStyleMetrics.padding_16;
                    padding_right: MaterialStyleMetrics.padding_16;

                    Rectangle {
                        z: 1;

                        HorizontalLayout {
                            min_height: MaterialStyleMetrics.size_64;
                            padding_top: MaterialStyleMetrics.padding_8;
                            padding_bottom: MaterialStyleMetrics.padding_8;
                            spacing: MaterialStyleMetrics.spacing_8;

                            CaptureBar {
                                horizontal_stretch: 1;
                                max_width: MaterialStyleMetrics.size_640;
                            }

                            if App.wide: Rectangle { }

                            VerticalLayout {
                                alignment: center;

                                TonalButton {
                                    icon: AppIcons.person;
                                    text: App.mode_label != "" ? App.mode_label : @tr("Away");

                                    clicked => {
                                        mode_dialog.open();
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                IconButton {
                                    icon: AppIcons.settings;
                                    tooltip: @tr("Settings");

                                    clicked => {
                                        App.open_settings();
                                    }
                                }
                            }
                        }
                    }

                    StatusStrip { }
                }
            }

            HorizontalLayout {
                vertical_stretch: 1;
                padding_right: App.wide ? MaterialStyleMetrics.padding_16 : 0px;
                padding_bottom: App.wide ? MaterialStyleMetrics.padding_16 : 0px;
                spacing: MaterialStyleMetrics.padding_16;

                // Exactly one page: detail (narrow), graph, settings, then the current tab.
                Rectangle {
                    horizontal_stretch: 1;
                    background: App.wide ? MaterialPalette.surface_container_low : transparent;
                    border_radius: App.wide ? MaterialStyleMetrics.border_radius_16 : 0px;
                    clip: true;

                    if root.full_detail: ItemPage { }
                    if !root.full_detail && App.graph_open: GraphPage { }
                    if !root.full_detail && !App.graph_open && App.settings_open: SettingsPage { }
                    if !root.full_detail && !App.graph_open && !App.settings_open && App.page == 0: TodayPage { }
                    if !root.full_detail && !App.graph_open && !App.settings_open && App.page == 1: InboxPage { }
                    if !root.full_detail && !App.graph_open && !App.settings_open && App.page == 2: ProjectsPage { }
                    if !root.full_detail && !App.graph_open && !App.settings_open && App.page == 3: HabitsPage { }
                    if !root.full_detail && !App.graph_open && !App.settings_open && App.page == 4: ReviewPage { }
                }

                if App.detail_open && App.two_pane: Rectangle {
                    horizontal_stretch: 1;
                    background: MaterialPalette.surface_container_low;
                    border_radius: MaterialStyleMetrics.border_radius_16;
                    clip: true;

                    ItemPage { }
                }
            }

            if !App.wide: NavigationBar {
                items: root.nav_items;
                current_index <=> App.page;

                index_changed(index) => {
                    App.navigate(index);
                }
            }
        }
    }

    mode_dialog := ModeDialog { }

    correction := TimeCorrectionDialog { }

    break_dialog := BreakDialog { }

    notice := NoticeBar {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - (App.wide ? MaterialStyleMetrics.padding_24 : MaterialStyleMetrics.size_80 + MaterialStyleMetrics.padding_16);
        width: min(root.width - 2 * MaterialStyleMetrics.padding_16, MaterialStyleMetrics.size_572);
    }
}
